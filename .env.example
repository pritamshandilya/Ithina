# dd_promo_api FastAPI backend (Campaign CRUD)
VITE_PROMO_API_URL=https://backend.promo.creativebits.tech

PROXY_N8N_TARGET=https://dev.n8n.creativebits.tech
PROXY_MERCURE_TARGET=https://dev.mercure.creativebits.tech

VITE_AUTH_SERVER_URL=http://localhost:3000
VITE_AUTH_REDIRECT_URI=http://localhost:5173

VITE_N8N_URL=/api
VITE_MERCURE_URL=/events

# Set to "true" to bypass auth guard during local development
VITE_SKIP_AUTH=true

# Set to "true" to enable React Query / TanStack Router devtools
VITE_DEBUG=false

# Router: production builds use hash URLs (#/wizard) so refresh works without nginx try_files.
# Set to "false" when nginx serves /cbai/promo/* → index.html (clean path URLs).
# VITE_USE_HASH_ROUTER=false
